{
  "name": "uuid-plus",
  "version": "1.0.0",
  "description": "Fast, secure and zero-dependency UUID toolkit for Node.js with UUID v4, v5, time-sortable v7, HMAC-based v8, validation, compact IDs, timestamps and batch generation.",
  "keywords": [
    "uuid",
    "uuid-plus",
    "uuid-generator",
    "uuidv4",
    "uuidv5",
    "uuidv7",
    "uuidv8",
    "guid",
    "unique-id",
    "id-generator",
    "identifier",
    "sortable-id",
    "time-sortable-id",
    "database-id",
    "compact-uuid",
    "nodejs",
    "javascript",
    "typescript",
    "hmac",
    "crypto",
    "express",
    "fastify",
    "nestjs",
    "zero-dependency"
  ],
  "author": "Sujal Patel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sujalpatel2209/uuid-plus.git"
  },
  "bugs": {
    "url": "https://github.com/sujalpatel2209/uuid-plus/issues"
  },
  "homepage": "https://github.com/sujalpatel2209/uuid-plus#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:local": "npm run build && node run-test.js",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
